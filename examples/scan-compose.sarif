{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "EscapeArmed",
          "version": "0.1.0",
          "informationUri": "https://github.com/ritvikindupuri/EscapeArmed",
          "rules": [
            {
              "id": "EA001",
              "name": "Privilegedcontainer",
              "shortDescription": {
                "text": "Privileged container"
              },
              "fullDescription": {
                "text": "--privileged disables almost every isolation boundary: all capabilities, all host devices, writable /proc/sys and /sys, no seccomp and no AppArmor. Host escape is a few shell commands away (core_pattern, cgroup release_agent, raw disk mount)."
              },
              "help": {
                "text": "--privileged disables almost every isolation boundary: all capabilities, all host devices, writable /proc/sys and /sys, no seccomp and no AppArmor. Host escape is a few shell commands away (core_pattern, cgroup release_agent, raw disk mount).\n\nFix: Remove privileged mode. Grant only the specific capability or device the workload needs.\nCVE-2025-31133: runc maskedPaths /dev/null symlink race. Fixed in runc 1.2.8, 1.3.3, 1.4.0-rc.3. https://github.com/opencontainers/runc/security/advisories/GHSA-9493-h29p-rfm2\nCVE-2025-52565: runc /dev/console bind mount race. Fixed in runc 1.2.8, 1.3.3, 1.4.0-rc.3. https://github.com/opencontainers/runc/security/advisories/GHSA-qw9x-cqr3-wc7r\nCVE-2025-52881: runc LSM bypass via misdirected procfs writes. Fixed in runc 1.2.8, 1.3.3, 1.4.0-rc.3. https://github.com/opencontainers/runc/security/advisories/GHSA-cgrx-mc8f-2prm"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "container",
                  "container-escape",
                  "CVE-2025-31133",
                  "CVE-2025-52565",
                  "CVE-2025-52881"
                ]
              }
            },
            {
              "id": "EA002",
              "name": "DangerousLinuxcapabilityadded",
              "shortDescription": {
                "text": "Dangerous Linux capability added"
              },
              "fullDescription": {
                "text": "Capabilities such as SYS_ADMIN, SYS_MODULE, DAC_READ_SEARCH, SYS_PTRACE, SYS_RAWIO and BPF each enable a known escape path (mounting, kernel module load, open_by_handle_at, process injection, raw IO, eBPF)."
              },
              "help": {
                "text": "Capabilities such as SYS_ADMIN, SYS_MODULE, DAC_READ_SEARCH, SYS_PTRACE, SYS_RAWIO and BPF each enable a known escape path (mounting, kernel module load, open_by_handle_at, process injection, raw IO, eBPF).\n\nFix: Drop ALL capabilities and add back only what is required. Never add SYS_ADMIN or SYS_MODULE."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "container",
                  "container-escape"
                ]
              }
            },
            {
              "id": "EA003",
              "name": "Containerruntimesocketmounted",
              "shortDescription": {
                "text": "Container runtime socket mounted"
              },
              "fullDescription": {
                "text": "A mounted docker.sock, containerd.sock or crio.sock gives full control of the runtime. Anyone in the container can start a new privileged container with the host root mounted. This is the primitive abused by Docker API cryptojacking campaigns."
              },
              "help": {
                "text": "A mounted docker.sock, containerd.sock or crio.sock gives full control of the runtime. Anyone in the container can start a new privileged container with the host root mounted. This is the primitive abused by Docker API cryptojacking campaigns.\n\nFix: Do not mount runtime sockets. Use a scoped API proxy or a dedicated build service instead."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "container",
                  "container-escape"
                ]
              }
            },
            {
              "id": "EA004",
              "name": "Hostrootfilesystemmounted",
              "shortDescription": {
                "text": "Host root filesystem mounted"
              },
              "fullDescription": {
                "text": "The host / is bind mounted into the container. Writing to it is equivalent to root on the host."
              },
              "help": {
                "text": "The host / is bind mounted into the container. Writing to it is equivalent to root on the host.\n\nFix: Mount only the exact host directory the workload needs, read-only where possible."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "container",
                  "container-escape"
                ]
              }
            },
            {
              "id": "EA006",
              "name": "HostPIDnamespaceshared",
              "shortDescription": {
                "text": "Host PID namespace shared"
              },
              "fullDescription": {
                "text": "With the host PID namespace the container sees every host process and can reach host filesystems through /proc/<pid>/root, or inject into processes with ptrace."
              },
              "help": {
                "text": "With the host PID namespace the container sees every host process and can reach host filesystems through /proc/<pid>/root, or inject into processes with ptrace.\n\nFix: Remove pid: host / hostPID: true."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "container",
                  "container-escape"
                ]
              }
            },
            {
              "id": "EA009",
              "name": "AppArmordisabled(unconfined)",
              "shortDescription": {
                "text": "AppArmor disabled (unconfined)"
              },
              "fullDescription": {
                "text": "Without AppArmor the container loses the default deny rules for mount, /proc/sys writes and other escape steps. Note that CVE-2025-52881 shows LSM labels alone are not enough."
              },
              "help": {
                "text": "Without AppArmor the container loses the default deny rules for mount, /proc/sys writes and other escape steps. Note that CVE-2025-52881 shows LSM labels alone are not enough.\n\nFix: Use the default docker-default or runtime/default AppArmor profile.\nCVE-2025-52881: runc LSM bypass via misdirected procfs writes. Fixed in runc 1.2.8, 1.3.3, 1.4.0-rc.3. https://github.com/opencontainers/runc/security/advisories/GHSA-cgrx-mc8f-2prm"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "container",
                  "container-escape",
                  "CVE-2025-52881"
                ]
              }
            },
            {
              "id": "EA012",
              "name": "Hostcgroupnamespaceorwritablecgroupfs",
              "shortDescription": {
                "text": "Host cgroup namespace or writable cgroupfs"
              },
              "fullDescription": {
                "text": "A host cgroup namespace or writable /sys/fs/cgroup makes the cgroup v1 release_agent escape reachable when combined with SYS_ADMIN."
              },
              "help": {
                "text": "A host cgroup namespace or writable /sys/fs/cgroup makes the cgroup v1 release_agent escape reachable when combined with SYS_ADMIN.\n\nFix: Use a private cgroup namespace (the default on cgroup v2) and never mount cgroupfs read-write."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "container",
                  "container-escape"
                ]
              }
            },
            {
              "id": "EA013",
              "name": "Rootincontainerwithoutusernamespace",
              "shortDescription": {
                "text": "Root in container without user namespace"
              },
              "fullDescription": {
                "text": "UID 0 in the container is UID 0 on the host. User namespaces (rootless or userns-remap) are the main mitigation for the November 2025 runc escapes because the remapped root cannot write host procfs files."
              },
              "help": {
                "text": "UID 0 in the container is UID 0 on the host. User namespaces (rootless or userns-remap) are the main mitigation for the November 2025 runc escapes because the remapped root cannot write host procfs files.\n\nFix: Run as a non-root USER, and enable user namespaces (rootless Docker, userns-remap, or Kubernetes hostUsers: false).\nCVE-2025-31133: runc maskedPaths /dev/null symlink race. Fixed in runc 1.2.8, 1.3.3, 1.4.0-rc.3. https://github.com/opencontainers/runc/security/advisories/GHSA-9493-h29p-rfm2\nCVE-2025-52565: runc /dev/console bind mount race. Fixed in runc 1.2.8, 1.3.3, 1.4.0-rc.3. https://github.com/opencontainers/runc/security/advisories/GHSA-qw9x-cqr3-wc7r\nCVE-2025-52881: runc LSM bypass via misdirected procfs writes. Fixed in runc 1.2.8, 1.3.3, 1.4.0-rc.3. https://github.com/opencontainers/runc/security/advisories/GHSA-cgrx-mc8f-2prm"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "container",
                  "container-escape",
                  "CVE-2025-31133",
                  "CVE-2025-52565",
                  "CVE-2025-52881"
                ]
              }
            },
            {
              "id": "EA014",
              "name": "no-new-privilegesnotset",
              "shortDescription": {
                "text": "no-new-privileges not set"
              },
              "fullDescription": {
                "text": "Setuid binaries inside the container can still raise privileges."
              },
              "help": {
                "text": "Setuid binaries inside the container can still raise privileges.\n\nFix: Set security_opt: no-new-privileges:true or allowPrivilegeEscalation: false."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "security-severity": "3.0",
                "tags": [
                  "security",
                  "container",
                  "container-escape"
                ]
              }
            },
            {
              "id": "EA025",
              "name": "Writablehostbindmount",
              "shortDescription": {
                "text": "Writable host bind mount"
              },
              "fullDescription": {
                "text": "A host directory is bind mounted read-write. Anything written in the container lands on the host, which is a persistence and tampering path even when the directory looks harmless."
              },
              "help": {
                "text": "A host directory is bind mounted read-write. Anything written in the container lands on the host, which is a persistence and tampering path even when the directory looks harmless.\n\nFix: Mount host paths read-only, or use a named volume."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "container",
                  "container-escape"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "EA001",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Privileged container: Container runs with --privileged. Related: CVE-2025-31133, CVE-2025-52565, CVE-2025-52881."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo/docker-compose.yml"
                },
                "region": {
                  "startLine": 6
                }
              }
            }
          ],
          "properties": {
            "security-severity": "9.5",
            "target": "demo/docker-compose.yml#vulnapp",
            "proof": "NOT_TESTED"
          }
        },
