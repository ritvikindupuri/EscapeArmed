          }
        },
        {
          "ruleId": "EA023",
          "ruleIndex": 5,
          "level": "warning",
          "message": {
            "text": "Runtime socket writable by non-root on host: /var/run/docker.sock is writable by group docker (op2rfrc8). Each member is effectively root."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "container/kali"
                },
                "region": {
                  "startLine": 1
